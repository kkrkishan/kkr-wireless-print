<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KKR.PrintServer.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>PrintOfo.Server</AssemblyName>
    <Product>Print Ofo</Product>
    <Description>Print Ofo — Windows Print Server</Description>
    <Company>Print Ofo</Company>
    <Copyright>Copyright © 2026 Print Ofo</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KKR.PrintServer.Core\KKR.PrintServer.Core.csproj" />
    <ProjectReference Include="..\KKR.PrintServer.Api\KKR.PrintServer.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
</Project>
