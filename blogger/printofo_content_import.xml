  <!-- HOW TO SETUP (3 STEPS) -->
  <h2 style="color: #0f172a; font-size: 24px; border-bottom: 2px solid #0284c7; padding-bottom: 8px; margin-top: 40px;">
    Quick Setup Guide (Under 2 Minutes)
  </h2>

